{
  "name": "@lynxhub/hwmonitor",
  "version": "0.12.0",
  "description": "Lynx Hardware Monitor is a Node.js module that tracks your system's CPU, GPU, memory, motherboard, storage, and network.",
  "homepage": "https://github.com/TheLynxHub/LynxHub-HWMonitor",
  "bugs": {
    "url": "https://github.com/TheLynxHub/LynxHub-HWMonitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheLynxHub/LynxHub-HWMonitor.git"
  },
  "license": "MIT",
  "author": "KindaBrazy <kindofbrazy@gmail.com> (https://github.com/KindaBrazy)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "publishPackage": "npm run build && npm publish --access public",
    "start": "npm run build && node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false",
    "lint": "prettier --write src --list-different && eslint --fix src",
    "validate": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "decompress": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/decompress": "^4.2.7",
    "@types/node": "^25.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
